# =======================================================
# ProcurementAI — Environment Configuration Template
# Copy this file to .env and customize as needed.
# =======================================================

# ---------------------------------------------------------------
# LLM / Gemini Configuration
# ---------------------------------------------------------------
# Optional: Set your Gemini API key for live generative agent reasoning.
# If omitted or left blank, the application automatically uses intelligent
# rule-based and heuristic fallback logic so all demos and tests succeed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------
# Database Persistence Configuration
# ---------------------------------------------------------------
# Default (Zero Setup): Local SQLite file
DATABASE_URL=sqlite:///./procurement.db

# Production / Docker: Uncomment to use PostgreSQL
# DATABASE_URL=postgresql://procurement_user:procurement_secret_password@localhost:5432/procurement_db

# ---------------------------------------------------------------
# Server & Frontend URLs
# ---------------------------------------------------------------
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ============================================================
# ProcurementAI Root Environment Variables (.env.example)
# Copy this file to .env and fill in your credentials.
# ============================================================

# Gemini AI Key (Optional - application runs fallback logic if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Defaults to sqlite:///./procurement.db)
DATABASE_URL=sqlite:///./procurement.db

# Twilio Credentials for AI Voice Outreach Agent
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15550000000

# Cloudflare Tunnel URL for Twilio Webhook callbacks
PUBLIC_URL=https://your-tunnel-name.trycloudflare.com

# Service Ports
PORT=3001
FASTAPI_PORT=8000
NEXT_PORT=3000

# Demo Supplier phone number for live voice call testing (E.164 format)
DEMO_SUPPLIER_PHONE_NUMBER=+15551234567

# Webhook URL for Twilio to call the FastAPI backend or twilio-voice node server (optional)
PUBLIC_WEBHOOK_BASE_URL=https://your-tunnel-url.loca.lt

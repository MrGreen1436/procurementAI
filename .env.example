# ================================================================
# .env.example — copy to .env and fill in your real values
# ================================================================

# --- Gemini (Google) — PRIMARY LLM used by this project --------
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Which Gemini model to use (default shown below)
# Options: gemini-2.0-flash | gemini-2.0-pro | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI — alternative if you switch the LLM backend --------
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# --- Anthropic — alternative if you switch the LLM backend -----
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Server settings (optional) --------------------------------
# PORT=8000

# ================================================================
# Vapi real voice calls (Task 6 — Vapi integration)
# ================================================================

# --- Vapi credentials ------------------------------------------
# Get your API key at: https://dashboard.vapi.ai/account
VAPI_API_KEY=your-vapi-api-key-here

# --- Vapi assistant ID -----------------------------------------
# Create an assistant at https://dashboard.vapi.ai, then copy its ID here.
# System prompt for the assistant (set in dashboard):
#   "You are calling on behalf of a procurement team to check on a specific
#    material order. Ask the person: (1) What is the current unit price for
#    [MATERIAL_NAME]? (2) What is the current lead time in days?
#    (3) Is it currently in stock or low stock? Keep the call brief and
#    professional. Once you have all three answers, thank them and end the call."
VAPI_ASSISTANT_ID=your-vapi-assistant-id-here

# --- Vapi phone number ID --------------------------------------
# The outbound phone number configured in your Vapi dashboard.
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id-here

# --- Demo supplier phone number --------------------------------
# A teammate's real phone number in E.164 format — NOT a real supplier.
# This is the number Vapi will call during the demo.
DEMO_SUPPLIER_PHONE_NUMBER=+1XXXXXXXXXX

# --- Feature flag ----------------------------------------------
# Set to "true" to enable real Vapi calls.
# Set to "false" (default) to use the safe simulation instead.
# Flip this back to "false" at any time with zero code changes.
USE_REAL_VOICE_CALLS=false

# ================================================================
# Multi-Channel Alerts — Slack (Feature 7)
# ================================================================

# --- Slack Incoming Webhook URL ---------------------------------
# Create one at: https://api.slack.com/apps → "Incoming Webhooks"
# Enable "Incoming Webhooks" → "Add New Webhook to Workspace"
# Copy the generated URL (starts with https://hooks.slack.com/services/...)
#
# When set: a Slack message is fired automatically whenever a human
#           confirms (approves) an anomaly via POST /anomaly-records/{key}/approve.
# When unset (default): the Slack step is silently skipped — nothing breaks.
#
# Alert severity thresholds (derived from anomaly_reason):
#   🔴 CRITICAL — "Both order quantity and price are anomalous"
#   🟠 HIGH     — "Order quantity far exceeds demand forecast"
#                 "Price significantly deviates from competitor pricing"
#   (Alerts with severity < HIGH are filtered out by default)
SLACK_WEBHOOK_URL=

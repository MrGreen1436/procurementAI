# ============================================================
# twilio-voice/.env.example
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# ============================================================

# ── Twilio credentials ──────────────────────────────────────
# Find these at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio outbound phone number in E.164 format
# (must be purchased/configured in your Twilio console)
TWILIO_PHONE_NUMBER=+15550000000

# ── Public tunnel URL ───────────────────────────────────────
# The HTTPS URL that cloudflared generates for your local server.
# Twilio must be able to reach this URL to POST to your webhooks.
#
# How to get it:
#   1. Install cloudflared (one-time):
#      winget install --id Cloudflare.cloudflared --accept-source-agreements --accept-package-agreements
#
#   2. Start the tunnel (in a separate terminal):
#      cloudflared tunnel --url http://localhost:3001
#
#   3. Copy the https://xxxx.trycloudflare.com URL printed by cloudflared
#      and paste it below (no trailing slash).
#
# Note: The URL changes every time you restart cloudflared.
# When it changes, update PUBLIC_URL here and restart the Node server.
PUBLIC_URL=https://your-tunnel-name.trycloudflare.com

# ── Server port (optional, defaults to 3001) ────────────────
# Must NOT conflict with Next.js (3000) or FastAPI (8000)
PORT=3001
